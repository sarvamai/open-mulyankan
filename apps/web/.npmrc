# @sarvam/tatva is vendored as a tarball (see ../../design-system/tatva/README.md), so
# this repository needs no private-registry credential. Everything else resolves
# from the public npm registry.
#
# Tatva declares `sonner: ^1.4` as a peer while this app tracks sonner 2.x, and
# declares `ai: ^4` while bundling `ai@^6` itself. Neither mismatch affects the
# components in use, so peers are not enforced strictly.
strict-peer-dependencies=false

# Cooling-off period: a version published less than 7 days ago is not resolved,
# so a compromised release has to survive a week of public scrutiny before it
# can enter a build. Needs pnpm >= 10.16 (see "packageManager" in
# package.json). Belt and braces with the committed lockfile and
# `pnpm install --frozen-lockfile` in CI.
#
# `min-release-age` is npm's spelling of the same control, kept so the setting
# still holds if this app is ever installed with npm.
minimum-release-age=10080
min-release-age=7
